[TEMPLATE]
# Clé uniquement côté serveur. Ne jamais préfixer avec NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-luna
MISTRAL_API_KEY=
MISTRAL_CHAT_MODEL=mistral-small-latest

# SMTP Hostinger pour la newsletter (renseigner dans .env.local)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=
